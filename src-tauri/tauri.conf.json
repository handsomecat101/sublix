{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sublix",
  "version": "0.5.0",
  "identifier": "com.sublix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sublix v0.5.0 — Settings",
        "width": 760,
        "height": 880,
        "minWidth": 520,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "title": "Sublix v0.5.0 — Overlay",
        "width": 720,
        "height": 150,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "minimizable": false,
        "maximizable": false,
        "focus": false,
        "url": "index.html?window=overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
